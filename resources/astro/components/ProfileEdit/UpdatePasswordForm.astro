---
import InputLabel from "@astro/components/InputLabel.astro";
import TextInput from "@astro/components/TextInput.astro";
import InputError from "@astro/components/InputError.astro";
import PrimaryButton from "@astro/components/PrimaryButton.astro";
import { errors, session } from "mighty/public/utils";
import { CSRF, Method } from "mightyModule";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;

const formErrors = errors<{
    current_password?: string;
    password?: string;
    password_confirmation?: string;
}>("updatePassword");

const isSaved = session("status") === "password-updated";
---

<section class={className}>
    <header>
        <h2 class="text-lg font-medium text-gray-900 dark:text-gray-100">
            Update Password
        </h2>

        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Ensure your account is using a long, random password to stay secure.
        </p>
    </header>

    <form
        id="update-password-form"
        method="POST"
        action="/password"
        class="mt-6 space-y-6"
    >
        <CSRF />
        <Method put />

        <div>
            <InputLabel for="current_password" value="Current Password" />

            <TextInput
                id="current_password"
                name="current_password"
                type="password"
                class="mt-1 block w-full"
                autocomplete="current-password"
            />

            <InputError
                id="update-password-current_password-error"
                message={formErrors.current_password}
                class="mt-2"
            />
        </div>

        <div>
            <InputLabel for="password" value="New Password" />

            <TextInput
                id="password"
                name="password"
                type="password"
                class="mt-1 block w-full"
                autocomplete="new-password"
            />

            <InputError
                id="update-password-password-error"
                message={formErrors.password}
                class="mt-2"
            />
        </div>

        <div>
            <InputLabel for="password_confirmation" value="Confirm Password" />

            <TextInput
                id="password_confirmation"
                name="password_confirmation"
                type="password"
                class="mt-1 block w-full"
                autocomplete="new-password"
            />
        </div>

        <div class="flex items-center gap-4">
            <PrimaryButton id="update-password-submit-button">
                Save
            </PrimaryButton>

            {
                isSaved && (
                    <p
                        id="password-updated-message"
                        class="text-sm text-gray-600 dark:text-gray-400"
                    >
                        Saved.
                    </p>
                )
            }
        </div>
    </form>

    <script>
        document.addEventListener("astro:page-load", () => {
            const passwordUpdatedMessageEl = document.getElementById(
                "password-updated-message"
            );
            if (passwordUpdatedMessageEl) {
                setTimeout(() => {
                    passwordUpdatedMessageEl.hidden = true;
                }, 2000);
            }
        });
    </script>

    <script>
        document.addEventListener("astro:page-load", () => {
            document
                .getElementById("update-password-form")
                ?.addEventListener("submit", () => {
                    (
                        document.getElementById(
                            "update-password-submit-button"
                        ) as HTMLButtonElement
                    ).disabled = true;
                    (
                        document.getElementById(
                            "update-password-current_password-error"
                        ) as HTMLParagraphElement
                    ).innerHTML = "";
                    (
                        document.getElementById(
                            "update-password-password-error"
                        ) as HTMLParagraphElement
                    ).innerHTML = "";
                });
        });
    </script>
</section>
