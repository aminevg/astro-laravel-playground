---
interface Props extends astroHTML.JSX.LabelHTMLAttributes {
    value?: string;
}

const { value, class: className, ...rest } = Astro.props;
---

<label
    {...rest}
    class:list={[
        "block text-sm font-medium text-gray-700 dark:text-gray-300",
        className,
    ]}
>
    {value ? value : <slot />}
</label>
