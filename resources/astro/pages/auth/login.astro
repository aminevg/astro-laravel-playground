---
import Checkbox from "@astro/components/Checkbox.astro";
import InputError from "@astro/components/InputError.astro";
import InputLabel from "@astro/components/InputLabel.astro";
import PrimaryButton from "@astro/components/PrimaryButton.astro";
import TextInput from "@astro/components/TextInput.astro";
import GuestLayout from "@astro/layouts/GuestLayout.astro";
import { errors } from "mighty/public/utils";
import { CSRF } from "mightyModule";

interface Props {
    canResetPassword: boolean;
    status: string | null;
    oldInput: Record<string, string> | null;
}

const { canResetPassword, status, oldInput } = Astro.props;

const formErrors = errors<{ email?: string; password?: string }>();
---

<GuestLayout title="Log in">
    {
        status && (
            <div class="mb-4 text-sm font-medium text-green-600">{status}</div>
        )
    }

    <form id="login-form" action="/login" method="POST">
        <CSRF />
        <div>
            <InputLabel for="email" value="Email" />

            <TextInput
                name="email"
                type="email"
                class="mt-1 block w-full"
                required
                autofocus
                autocomplete="username"
                value={oldInput?.email}
            />

            <InputError class="mt-2" message={formErrors.email} />
        </div>

        <div class="mt-4">
            <InputLabel for="password" value="Password" />

            <TextInput
                name="password"
                type="password"
                class="mt-1 block w-full"
                required
                autocomplete="current-password"
            />

            <InputError class="mt-2" message={formErrors.password} />
        </div>

        <div class="mt-4 block">
            <label class="flex items-center">
                <Checkbox name="remember" checked={oldInput?.remember} />
                <span class="ms-2 text-sm text-gray-600 dark:text-gray-400"
                    >Remember me</span
                >
            </label>
        </div>

        <div class="mt-4 flex items-center justify-end">
            {
                canResetPassword && (
                    <a
                        href="/password/reset"
                        class="rounded-md text-sm text-gray-600 underline hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:text-gray-400 dark:hover:text-gray-100 dark:focus:ring-offset-gray-800"
                    >
                        Forgot your password?
                    </a>
                )
            }

            <PrimaryButton id="login-submit-button" class="ms-4">
                Log in
            </PrimaryButton>
        </div>
    </form>

    <script>
        document
            .getElementById("login-form")
            ?.addEventListener("submit", (event) => {
                (
                    document.getElementById(
                        "login-submit-button"
                    ) as HTMLButtonElement
                ).disabled = true;
            });
    </script>
</GuestLayout>
